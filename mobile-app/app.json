{
  "expo": {
    "name": "mobile-app",
    "slug": "mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobileapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "বেচা-কেনা অ্যাপ আপনার পরিচয় যাচাইয়ের জন্য সেলফি তুলতে ক্যামেরা ব্যবহার করে।",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "বিজ্ঞাপনের ছবি ও KYC সেলফি বেছে নিতে বেচা-কেনা আপনার ফটো লাইব্রেরি ব্যবহার করে। (Becha-Kena uses your photos for ad pictures.)",
          "cameraPermission": "বিজ্ঞাপনের ছবি ও পরিচয় যাচাইয়ের সেলফি তুলতে বেচা-কেনা ক্যামেরা ব্যবহার করে। (Becha-Kena uses the camera for ad photos and the verification selfie.)"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "আপনার কাছাকাছি বিজ্ঞাপন দেখাতে ও বিজ্ঞাপনের এলাকা বেছে নিতে বেচা-কেনা আপনার লোকেশন ব্যবহার করে। (Becha-Kena uses your location to show nearby ads.)"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00704A",
          "defaultChannel": "default"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
