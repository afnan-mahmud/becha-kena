# Backend API Base URL (with /api/v1)
# For physical device / Expo Go: use your laptop LAN IP, e.g. http://192.168.0.105:5000/api/v1
# For Android emulator: http://10.0.2.2:5000/api/v1
# For iOS simulator / Web: http://localhost:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1

# Socket.io Origin URL (NO /api/v1)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
